r = subprocess.run(["bash", "-lc", f"""
set -e
rm -rf /tmp/dry_run_workspaces
{venv}/bin/python - <<'PY'
import sys
sys.path.insert(0, "{cwd}/tasks/issue-fix/.jaato/scripts")
import checkout_worktree as cw
from pathlib import Path

workspace_root = Path("/tmp/dry_run_workspaces")
workspace_root.mkdir(parents=True)

repo = "/tmp/toy-repo"
cache_root = workspace_root / ".repo-cache"

# Simulate what fixture.materialise does for TWO arms of the sweep:
# each gets its own pre-existing (fixture-copied) workspace dir.
arm_ids = ["issue-fix_sweep@openrouter_gpt5mini#0", "issue-fix_sweep@openrouter_gemini25flash#0"]
for arm_id in arm_ids:
    slug = arm_id.replace("/", "_").replace("#", "_")
    ws = workspace_root / slug
    ws.mkdir(parents=True)
    (ws / "README.md").write_text("scratch\\n")  # mimics the fixture copy
    (ws / ".env").write_text("JAATO_PROFILE_SET=x\\n")

for arm_id in arm_ids:
    slug = arm_id.replace("/", "_").replace("#", "_")
    ws = workspace_root / slug
    mirror_dir = cw._ensure_mirror(repo, cache_root)
    base_ref = cw._default_branch(mirror_dir)
    branch = f"issue-fix/{{slug}}"
    target = ws / "repo"
    cw._materialise_worktree(mirror_dir, target, branch, base_ref)
    base_sha = cw._run(["git", "-C", str(target), "rev-parse", "HEAD"]).stdout.strip()
    (ws / ".base_commit").write_text(base_sha + "\\n")
    print(f"arm={{arm_id}} -> {{target}}  branch={{branch}}  base={{base_sha[:8]}}")

print("mirror clone exists:", (cache_root / "__tmp__toy-repo.git").exists() or list(cache_root.glob("*.git")))
PY
echo EXIT=$?
"""], capture_output=True, text=True)
print(r.stdout)
print("STDERR", r.stderr[-3000:])

