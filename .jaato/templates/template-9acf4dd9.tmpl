r = subprocess.run(["bash", "-lc", f"""
set -e
rm -rf /tmp/real_dry_run
mkdir -p /tmp/real_dry_run
{venv}/bin/python - <<'PY'
import sys, time
sys.path.insert(0, "{cwd}/tasks/issue-fix/.jaato/scripts")
import checkout_worktree as cw
from pathlib import Path

workspace_root = Path("/tmp/real_dry_run")
repo = "Jaato-framework-and-examples/jaato"
cache_root = workspace_root / ".repo-cache"

arm_id = "issue-fix_sweep@openrouter_gpt5mini#0"
slug = arm_id.replace("/", "_").replace("#", "_")
ws = workspace_root / slug
ws.mkdir(parents=True)
(ws / "README.md").write_text("scratch\\n")
(ws / ".env").write_text("JAATO_PROFILE_SET=x\\n")

t0 = time.time()
mirror_dir = cw._ensure_mirror(repo, cache_root)
print("mirror clone took", round(time.time() - t0, 1), "s ->", mirror_dir, mirror_dir.is_dir())

base_ref = cw._default_branch(mirror_dir)
branch = f"issue-fix/{{slug}}"
target = ws / "repo"
cw._materialise_worktree(mirror_dir, target, branch, base_ref)
print("worktree created at", target, target.is_dir())

base_sha = cw._run(["git", "-C", str(target), "rev-parse", "HEAD"]).stdout.strip()
print("base_sha:", base_sha)
print("target has files:", len(list(target.iterdir())))
PY
echo EXIT=$?
"""], capture_output=True, text=True)
print(r.stdout)
print("STDERR", r.stderr[-2000:])

