# Copy to .env.  The sweep reads this from the harness root.
#
# The provider key is NOT set here.  It lives in ~/.jaato/openrouter_auth.json
# (mode 0600) and is resolved daemon-side; arms run untrusted model-authored
# code inside their own workspaces, so a key in a workspace .env would be
# readable by the thing under test.
JAATO_PROVIDER=openrouter

# One warm pool slot.  The pool is a FLOOR as well as a ceiling and each slot
# is ~130 MB resident; raise only for CONCURRENT fan-out, not sequential arms.
JAATO_RUNNER_POOL_SIZE=1

# No permission timeout: an unattended arm must wait for an answer rather than
# auto-resolving while nobody is looking.
JAATO_PERMISSION_TIMEOUT=0

# config_root does not derive on its own here — file_edit fails to resolve its
# backup base dir without it, which silently empties the whole tool surface.
# Set to <this directory>/.jaato
JAATO_CONFIG_ROOT=/absolute/path/to/this/checkout/.jaato
