# Run artefacts — regenerated by every sweep, and large.
# .jaato-eval-workspaces held 4.6 GB of per-arm git worktrees; an arm that ran
# `git add -A` from the wrong cwd once committed the bare repo-cache mirror
# into the harness's own history, which is why this entry comes first.
.jaato-eval-workspaces/
results*.jsonl
sweep_run*.log
*_trace*.log
client_trace.log

# Session state — per-run, and it carries model output and file backups.
.jaato/logs/
.jaato/sessions/
**/.jaato/logs/
**/.jaato/sessions/

# Credentials — NEVER commit.  The openrouter key lives in ~/.jaato/, resolved
# daemon-side from a pass:// URI; nothing here should ever hold a literal.
*_auth.json
.env
!.env.example

# Python bytecode
__pycache__/
*.pyc
