# Copy to interrogate.env and pass it as interrogate.py's <env_file> argument.
#
# THE LINE THAT MATTERS is JAATO_PROFILE_SET.  Without it the arm is revived
# under the sweep's own profile, whose completion_payload_schema makes it fight
# a completion processor about acceptance criteria your question never involved.
JAATO_PROFILE_SET=interrogate

JAATO_PROVIDER=openrouter
JAATO_PERMISSION_TIMEOUT=0

# Same value the sweep uses — the interrogate profile set lives inside it.
# Set to <this checkout>/tasks/issue-fix/.jaato
JAATO_CONFIG_ROOT=/absolute/path/to/this/checkout/tasks/issue-fix/.jaato
